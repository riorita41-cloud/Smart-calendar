<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="csrf-token" content="{{ csrf_token('task_action') }}">
    <meta name="user-id" content="{{ app.user ? app.user.id : 'anonymous' }}">
    <title>{% block title %}Умный Календарь{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/navigation.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/responsive.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/modal.css') }}"> 
    
    {% block stylesheets %}{% endblock %}

    <!-- Временные стили для мобильного гамбургер-меню и оверлея (можно перенести в navigation.css) -->
    <style>
        /* Мобильная шапка (скрыта на ПК) */
        .mobile-header {
            display: none;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: #fff;
            border-bottom: 1px solid #eae5d9;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .mobile-menu-toggle {
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2c3e2d;
        }
        .mobile-brand {
            font-weight: 700;
            font-size: 1.1rem;
            color: #2c3e2d;
            text-decoration: none;
        }
        /* Затемнение фона при открытой шторке */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 101;
            backdrop-filter: blur(2px);
        }
        .sidebar-overlay.active {
            display: block;
        }

        /* Адаптивность для экранов меньше 768px */
        @media (max-width: 768px) {
            .mobile-header {
                display: flex;
            }
            .layout {
                flex-direction: column;
            }
            .sidebar {
                position: fixed;
                top: 0;
                left: -280px; /* Спрятано за экраном слева */
                width: 260px;
                height: 100%;
                z-index: 102;
                transition: transform 0.3s ease;
                box-shadow: 4px 0 15px rgba(0,0,0,0.1);
            }
            .sidebar.mobile-open {
                transform: translateX(280px); /* Выезжает на экран */
            }
            .sidebar-title {
                display: block; /* Показываем заголовок внутри шторки */
            }
        }
    </style>
</head>

<body class="{% block body_class %}{% endblock %}">
    
    <!-- Мобильная шапка с кнопкой бургер-меню -->
    <div class="mobile-header">
        <button class="mobile-menu-toggle" id="sidebarToggle" aria-label="Открыть меню">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <a href="{{ path('app_home') }}" class="mobile-brand">Умный Календарь</a>
        <div style="width: 24px;"></div> <!-- Пустой блок для выравнивания по центру -->
    </div>

    <!-- Затемнение фона -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="layout">
        {% block sidebar %}
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-title">Умный<br>Календарь</div>
            
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="{{ path('app_home') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        Главная
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_calendar') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_calendar' %}active{% endif %}">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        Календарь
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_tasks') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_tasks' %}active{% endif %}">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 11l3 3L22 4"></path>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                        Задачи
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_exams') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_exams' %}active{% endif %}">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        Экзамены
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_materials') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_materials' %}active{% endif %}">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                        </svg>
                        Материалы
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_pomodoro') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_pomodoro' %}active{% endif %}">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        Таймер
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_avatar') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_avatar' %}active{% endif %}">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Аватар
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_logout') }}" class="nav-link">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        Выйти
                    </a>
                </li>
            </ul>
        </aside>
        {% endblock %}
        
        <main class="main-content">
            {% for type in ['success', 'error'] %}
                {% for message in app.flashes(type) %}
                    <div class="flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            
            {% block body %}{% endblock %}
        </main>
    </div>

    <!-- Скрипт для управления выдвижной шторкой -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggleBtn = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('appSidebar');
        const overlay = document.getElementById('sidebarOverlay');

        function toggleMenu() {
            sidebar.classList.toggle('mobile-open');
            overlay.classList.toggle('active');
        }

        if (toggleBtn) {
            toggleBtn.addEventListener('click', toggleMenu);
        }
        if (overlay) {
            overlay.addEventListener('click', toggleMenu);
        }

        // Автоматически закрывать шторку при клике на любой пункт меню на мобилках
        const navLinks = sidebar.querySelectorAll('.nav-link');
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth <= 768) {
                    sidebar.classList.remove('mobile-open');
                    overlay.classList.remove('active');
                }
            });
        });

        // Обработка flash-сообщений
        const flashes = document.querySelectorAll('.flash-success, .flash-error');
        flashes.forEach(flash => {
            setTimeout(() => {
                flash.classList.add('fade-out');
                setTimeout(() => flash.remove(), 400);
            }, 3000);
            
            flash.addEventListener('click', function() {
                this.classList.add('fade-out');
                setTimeout(() => this.remove(), 400);
            });
        });
    });
    </script>

    <script src="{{ asset('js/api-utils.js') }}"></script>
    
    {% if app.request.attributes.get('_route') != 'app_pomodoro' %}
        <script src="{{ asset('js/global-timer.js') }}"></script>
    {% endif %}
    
    <script src="{{ asset('js/modal.js') }}"></script> 
    
    {% block javascripts %}{% endblock %}

    {% if app.request.attributes.get('_route') != 'app_pomodoro' %}
        <div id="global-timer-widget" class="global-timer-widget" style="display: none;">
            <span class="widget-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </span>
            <span class="widget-time" id="global-timer-time">25:00</span>
            <a href="{{ path('app_pomodoro') }}" class="widget-expand">Развернуть</a>
        </div>
    {% endif %}
</body>
</html>